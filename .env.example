# Domain
DOMAIN=localhost

# CI/CD Environment
CI=false

# Frontend hosts
FRONTEND_HOST=http://localhost:5173
FRONTEND_COMPANIES_HOST=http://localhost:5174

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Your Project Name"
STACK_NAME=your-stack-name

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,http://localhost:5174"
SECRET_KEY=changethis                    # 🔴 Generate with: openssl rand -base64 32
FIRST_SUPERUSER=admin@example.com        # ⚠️ Change to your admin email
FIRST_SUPERUSER_PASSWORD=changethis      # 🔴 Choose a strong password

# Frontend / Homepage
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here   # 🔴 Get from Google Cloud Console

# Emails
SMTP_HOST=your-smtp-host
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=changethis                 # 🔴 Your SMTP password
EMAILS_FROM_EMAIL=noreply@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis             # 🔴 Choose a strong password

# Sentry (optional)
SENTRY_DSN=

# Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
DOCKER_IMAGE_FRONTEND_COMPANIES=frontend_companies

# Keycloak configuration (optional)
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=                  # 🔴 Your Keycloak client secret

# AWS S3 configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id         # 🔴 IAM user access key
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key  # 🔴 IAM user secret key
AWS_REGION=us-east-2
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_S3_MAX_FILE_SIZE=10485760  # 10MB in bytes
